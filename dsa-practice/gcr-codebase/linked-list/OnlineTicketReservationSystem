import java.time.LocalDateTime;

public class TicketReservationSystem {

    static Node head = null;

    // Circular Linked List Node
    static class Node {
        int ticketId;
        String customerName;
        String movieName;
        String seatNumber;
        LocalDateTime bookingTime;
        Node next;

        Node(int ticketId, String customerName, String movieName,
             String seatNumber, LocalDateTime bookingTime) {
            this.ticketId = ticketId;
            this.customerName = customerName;
            this.movieName = movieName;
            this.seatNumber = seatNumber;
            this.bookingTime = bookingTime;
            this.next = null;
        }
    }

    // Add ticket at end
    public static void addTicket(int id, String customer, String movie,
                                 String seat, LocalDateTime time) {

        Node newNode = new Node(id, customer, movie, seat, time);

        if (head == null) {
            head = newNode;
            newNode.next = head;
            return;
        }

        Node temp = head;
        while (temp.next != head) {
            temp = temp.next;
        }

        temp.next = newNode;
        newNode.next = head;
    }

    // Remove ticket by Ticket ID
    public static void removeTicket(int id) {

        if (head == null) {
            System.out.println("No tickets available");
            return;
        }

        Node curr = head;
        Node prev = null;

        do {
            if (curr.ticketId == id) {

                if (curr == head && curr.next == head) {
                    head = null;
                } else {
                    if (curr == head) {
                        Node last = head;
                        while (last.next != head)
                            last = last.next;
                        head = head.next;
                        last.next = head;
                    } else {
                        prev.next = curr.next;
                    }
                }

                System.out.println("Ticket removed: " + id);
                return;
            }

            prev = curr;
            curr = curr.next;

        } while (curr != head);

        System.out.println("Ticket not found");
    }

    // Display all tickets
    public static void displayTickets() {

        if (head == null) {
            System.out.println("No booked tickets");
            return;
        }

        Node temp = head;
        do {
            printTicket(temp);
            temp = temp.next;
        } while (temp != head);
    }

    // Search by Customer Name or Movie Name
    public static void searchTicket(String key) {

        if (head == null) {
            System.out.println("No tickets available");
            return;
        }

        Node temp = head;
        boolean found = false;

        do {
            if (temp.customerName.equalsIgnoreCase(key) ||
                temp.movieName.equalsIgnoreCase(key)) {
                printTicket(temp);
                found = true;
            }
            temp = temp.next;
        } while (temp != head);

        if (!found)
            System.out.println("No matching ticket found");
    }

    // Count total tickets
    public static int countTickets() {

        if (head == null)
            return 0;

        int count = 0;
        Node temp = head;

        do {
            count++;
            temp = temp.next;
        } while (temp != head);

        return count;
    }

    // Helper method
    private static void printTicket(Node t) {
        System.out.println(
                "Ticket ID: " + t.ticketId +
                ", Customer: " + t.customerName +
                ", Movie: " + t.movieName +
                ", Seat: " + t.seatNumber +
                ", Time: " + t.bookingTime
        );
    }

    // Main Method
    public static void main(String[] args) {

        addTicket(101, "Ravi", "RRR", "A1", LocalDateTime.now());
        addTicket(102, "Amit", "KGF", "B5", LocalDateTime.now());
        addTicket(103, "Neha", "Dangal", "C3", LocalDateTime.now());

        System.out.println("\nAll Tickets:");
        displayTickets();

        System.out.println("\nSearch Ticket:");
        searchTicket("RRR");

        System.out.println("\nRemove Ticket:");
        removeTicket(102);

        System.out.println("\nFinal Tickets:");
        displayTickets();

        System.out.println("\nTotal Tickets: " + countTickets());
    }
}
